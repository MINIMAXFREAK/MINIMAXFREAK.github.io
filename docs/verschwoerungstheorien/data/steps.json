      "ablauf": [ { "clip": "schluss-uhr" }, { "anim": "fragekarte", "ueberblendung": 1.6 } ] },
    { "klick": 19, "id": "quellen", "name": "Quellen", "ablauf": [ { "folie": "quellen" } ] },
    { "klick": 20, "id": "ende", "name": "Ende (Schwarz)", "ablauf": [ { "schwarz": true } ] }
